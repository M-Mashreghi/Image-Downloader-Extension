{
  "manifest_version": 3,
  "name": "Image Collector - Download All as ZIP",
  "version": "1.0.0",
  "description": "Turn it on and it collects every image you see. Download them all as one ZIP, named 1, 2, 3...",
  "permissions": ["storage", "webRequest", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Collector (OFF)",
    "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png", "48": "icons/off48.png", "128": "icons/off128.png" }
  },
  "icons": { "16": "icons/on16.png", "32": "icons/on32.png", "48": "icons/on48.png", "128": "icons/on128.png" }
}
